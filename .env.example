# ==============================================================================
# TITANFIT AI — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to `.env.local` and supply your real credentials.
# NEVER commit `.env.local` or expose secret/service-role keys to the browser.
# ==============================================================================

# 1. Supabase Configuration (Required for Authentication & Database Persistence)
# Obtain from: Supabase Dashboard -> Project Settings -> API (or Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional alternative if your Supabase project uses the newer publishable-key format (`sb_publishable_...`):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only Supabase key ONLY if you want full auth.users deletion from /api/account/delete.
# NEVER prefix this variable with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# 2. AI Fitness Coach LLM Configuration (Server-Side Only — Required only for AI Coach Chat)
# Supports any OpenAI-compatible Chat Completions provider (OpenAI, Groq, OpenRouter, Together, etc.)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional custom OpenAI-compatible base URL (defaults to https://api.openai.com/v1):
# LLM_BASE_URL=https://api.openai.com/v1

# 3. Optional Application Base URL (Used for email verification & password recovery callbacks)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
